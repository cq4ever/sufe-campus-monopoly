# Server only: never put credentials in a VITE_ variable.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Public frontend configuration. Leave API base empty for same-origin Vercel.
VITE_API_BASE=
# Set your canonical public URL; also used by server CORS.
VITE_SITE_URL=
# Optional: true = presets only, with no API requests.
VITE_DISABLE_AI=false
